# Keep the build context small and — more importantly — keep secrets, uploaded
# files, database dumps and local artifacts OUT of the image.
.git
.github
.vercel
.claude
.claude-*
.agents
.semgrep
.sonar
.remember
node_modules
**/node_modules
**/dist
**/.expo
**/test-results
**/playwright-report

# Secrets and local environment — never bake these into an image.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Not part of the web/API image. (The mobile/e2e/sandbox packages stay in the
# context — pnpm's frozen lockfile must still see every workspace member — but
# their dependencies are never installed: see the --filter flags in Dockerfile.)
chrome-extension
demo-output
