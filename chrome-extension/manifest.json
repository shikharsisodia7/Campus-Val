{
  "manifest_version": 3,
  "name": "CampusVal — SCU AI Advising",
  "version": "1.0.0",
  "description": "Quick access to CampusVal: AI advisor, planner, GPA, courses, transfer credit and voice advising for Santa Clara University.",
  "author": "CampusVal",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CampusVal",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": []
}
