{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && cross-env NODE_ENV=development pnpm run start",
    "dev:all": "pnpm --filter @workspace/scu-advising run build && pnpm run build && cross-env NODE_ENV=development pnpm run start",
    "build:all": "pnpm --filter @workspace/scu-advising run build && pnpm run build",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/express": "^2.1.14",
    "@clerk/shared": "^4.10.1",
    "@google-cloud/storage": "^7.21.0",
    "@vercel/blob": "^2.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "google-auth-library": "^11.0.0",
    "http-proxy-middleware": "^4.0.0",
    "openai": "^4.103.0",
    "pino": "^9",
    "pino-http": "^10",
    "unpdf": "^1.8.0",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
}
