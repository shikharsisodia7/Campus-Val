{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && cross-env NODE_ENV=development pnpm run start",
    "dev:all": "pnpm --filter @workspace/scu-advising run build && pnpm run build && cross-env NODE_ENV=development pnpm run start",
    "build:all": "pnpm --filter @workspace/scu-advising run build && pnpm run build",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "import-registrar-tentatives": "tsx scripts/import-registrar-tentatives.ts",
    "extract-component-markers": "tsx scripts/extract-registrar-component-markers.ts",
    "audit-components": "tsx scripts/audit-course-components.ts",
    "verify-apr": "tsx scripts/verify-apr-export.ts",
    "audit:requirements": "tsx scripts/audit-requirements.ts",
    "seed-e2e-seats": "tsx scripts/seed-e2e-seat-data.ts",
    "test": "vitest run",
    "import:department-notes": "tsx scripts/import-department-notes.ts",
    "import:sample-plans": "tsx scripts/import-sample-plans.ts",
    "import:bulletin-courses": "tsx scripts/import-bulletin-courses.ts",
    "snapshot:bulletin": "tsx scripts/snapshot-bulletin.ts",
    "diff:bulletin": "tsx scripts/diff-bulletin.ts",
    "diff:bulletin-source": "tsx scripts/diff-bulletin-source.ts",
    "admin:scope": "tsx scripts/admin-scope.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.14",
    "@clerk/shared": "^4.10.1",
    "@google-cloud/storage": "^7.21.0",
    "@napi-rs/canvas": "0.1.68",
    "@vercel/blob": "^2.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "google-auth-library": "^11.0.0",
    "htmlparser2": "^10.1.0",
    "http-proxy-middleware": "^4.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "pino": "^9",
    "pino-http": "^10",
    "unpdf": "^1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.11"
  }
}
