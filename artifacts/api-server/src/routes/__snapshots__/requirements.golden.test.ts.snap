          "variant": null,
        },
        {
          "autoTracked": false,
          "choice": null,
          "complete": false,
          "courses": [],
          "crossSatisfiedBy": [],
          "description": "An educational enrichment experience selected from one of the following options: 8 or more units in a study abroad program that does not duplicate other coursework; acceptance to one of the school's master's degree programs and completion of at least the first 12 units of that program prior to completion of the undergraduate degree; undergraduate research with completion of 6 or more units of CSEN 193 (cannot also be used to satisfy a CSEN elective); 12 or more units approved by an academic advisor. The courses must be part of a theme or be in the same department, and may not also be used to satisfy other requirements of the student's primary major. Any units satisfying the Educational Enrichment requirement that are applied to the MS program must be in addition to the 182 units required for the undergraduate degree.",
          "id": "major-primary-educational-enrichment",
          "label": "Educational enrichment experience",
          "manual": true,
          "needsVerification": true,
          "phase": null,
          "plannedBy": [],
          "satisfiedBy": [],
          "section": "Educational enrichment",
          "status": "open",
          "variant": null,
        },
