# CampusVal environment variables — names only, never real values.
# See docs/SCU_DEPLOYMENT.md (hosting) and docs/DEPLOYMENT.md (Vercel) for where
# each of these is configured. The server validates this at startup and names
# every missing/invalid variable in one message (lib/config.ts).

# --- Required everywhere (local, container, VM, Vercel, Cloud Run) ---
# On Cloud Run + Cloud SQL (Unix socket, no public IP):
#   postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# See docs/migration/CLOUD_SQL.md. Store it in Secret Manager, never in git.
DATABASE_URL=

# --- Sign-in provider -----------------------------------------------------
# clerk (default, temporary) | oidc (SCU SSO — refused at startup until the SCU
# OIDC adapter is built from SCU's real issuer/claims; see
# docs/migration/SCU_SSO_MIGRATION.md). Clerk keys below apply when clerk.
AUTH_PROVIDER=clerk
# SCU SSO placeholders. Values come ONLY from SCU's identity team
# (docs/migration/SSO_INFORMATION_NEEDED.md). Not read by the code yet.
SCU_OIDC_ISSUER=
SCU_OIDC_CLIENT_ID=
SCU_OIDC_CLIENT_SECRET=
SCU_OIDC_REDIRECT_URI=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Baked into the web bundle at BUILD time (a public key, not a secret).
VITE_CLERK_PUBLISHABLE_KEY=

# --- Server process (long-running hosts: VM / container) ---
# Required by `node artifacts/api-server/dist/index.mjs`; ignored on Vercel.
PORT=8080
# Interface to bind. 0.0.0.0 (default) for containers/VMs; 127.0.0.1 when a
# same-host reverse proxy is the only client.
HOST=0.0.0.0
# production | development | test
NODE_ENV=production
# pino level: fatal|error|warn|info|debug|trace (default info). Logs are JSON
# on stdout in production, ready for any log shipper.
LOG_LEVEL=info

# --- Public URL, reverse proxy, TLS, CORS ---
# The externally visible origin, e.g. https://campusval.scu.edu. Used for
# canonical/OG URLs and for building absolute upload links. Set it in production.
PUBLIC_APP_URL=
# How many reverse-proxy hops to trust for X-Forwarded-* (client IP, https).
# Unset/false = trust none (correct when exposed directly). 1 = one proxy.
# Also accepts a hop count or a subnet list such as "loopback, 10.0.0.0/8".
TRUST_PROXY=
# Extra browser origins allowed to call the API with credentials (comma-
# separated). The bundled web app is same-origin and needs none. Production
# default = PUBLIC_APP_URL only.
CORS_ALLOWED_ORIGINS=

# --- Database ---
# Max connections in the pg pool. Default 5 (sized for serverless); raise for a
# long-running server, e.g. 10-20.
DATABASE_POOL_MAX=
# Where `node dist/migrate.mjs` finds migrations. Default: lib/db/drizzle next
# to the bundle (the container image already lays this out).
MIGRATIONS_DIR=

# --- Private object storage (Academic Progress Report uploads) ---
# Which backend: gcs | vercel-blob | local | replit. gcs must be set explicitly;
# otherwise, if unset, it is inferred:
# VERCEL set -> vercel-blob; PRIVATE_STORAGE_DIR set -> local; PRIVATE_OBJECT_DIR set -> replit.
# With none configured, APR upload is disabled (the rest of CampusVal works).
PRIVATE_STORAGE_PROVIDER=
# local: an absolute, PERSISTENT, PRIVATE directory. Back it up. Never serve it
# statically. In the container image this is /var/lib/campusval/private.
PRIVATE_STORAGE_DIR=
# local: 32+ random characters; signs the 15-minute upload links. Rotating it
# only invalidates in-flight uploads, not stored files.
STORAGE_SIGNING_SECRET=
# vercel-blob: auto-populated when a PRIVATE Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# replit: object-storage sidecar (Replit runtime only).
PRIVATE_OBJECT_DIR=
# gcs: name of a PRIVATE Cloud Storage bucket (uniform bucket-level access,
# public access prevention). Credentials = the Cloud Run service account; no key
# file. Also needs STORAGE_SIGNING_SECRET above. See docs/migration/CLOUD_STORAGE.md.
GCS_BUCKET=
# Largest APR file accepted, in MB (1-50, default 10). A reverse proxy in front of
# the app must allow at least this much (nginx: client_max_body_size).
APR_MAX_UPLOAD_MB=
# Largest Degree Checksheet file accepted, in MB (1-50, default 20). The same
# proxy rule applies.
CHECKSHEET_MAX_UPLOAD_MB=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Live section availability (Workday) — OFF until SCU approves a source ---
# Keep false until SCU/Tony provide the supported mechanism and credentials.
# Nothing in the UI claims live data while this is false.
WORKDAY_AVAILABILITY_ENABLED=false
# HTTPS endpoint returning CampusVal's documented availability payload
# (docs/SECTION_AVAILABILITY.md#the-input-contract). No default; no invented URL.
WORKDAY_AVAILABILITY_URL=
# Credential issued by SCU for that endpoint. Server-side only.
WORKDAY_AVAILABILITY_AUTH_TOKEN=
# Header carrying the credential (default Authorization) and its prefix
# (default "Bearer"; set empty to send the token bare).
WORKDAY_AVAILABILITY_AUTH_HEADER=
WORKDAY_AVAILABILITY_AUTH_SCHEME=
# Upstream request timeout, ms (default 5000).
WORKDAY_AVAILABILITY_TIMEOUT_MS=
# One upstream call per term per this many seconds, however many students ask
# (default 60).
WORKDAY_AVAILABILITY_CACHE_TTL_SECONDS=
# Data younger than this is labelled "live" (default 120).
WORKDAY_AVAILABILITY_LIVE_WITHIN_SECONDS=
# Data older than this is "stale" and its status is shown as unknown (default 900).
WORKDAY_AVAILABILITY_STALE_AFTER_SECONDS=
# Shortest gap a student's "Refresh availability" may force for one term
# (default 30). Bounds upstream traffic during registration.
WORKDAY_AVAILABILITY_MIN_REFRESH_SECONDS=
# Scheduled ingestion hook (POST /api/internal/availability/refresh). Off unless
# a secret of 24+ characters is set; the scheduler sends it as a Bearer token.
AVAILABILITY_INGEST_SECRET=
# Terms the hook refreshes, e.g. "fall-2026,winter-2027".
AVAILABILITY_INGEST_TERMS=

# --- Degree Completion Assessment (docs/DEGREE_COMPLETION_ASSESSMENT.md) ---
# PRIVATE R&D ONLY. Off unless set exactly to true; also requires an ADMIN_EMAILS user.
ENABLE_DEGREE_COMPLETION_RND=false
# REGISTRAR-DEPENDENT. Leave unset (false) until the Registrar confirms that
# Workday's "Remaining" on an In Progress row excludes the in-progress courses.
DEGREE_COMPLETION_IN_PROGRESS_REMAINING_IS_ADDITIONAL=
# PRIVATE R&D ONLY. Off unless set exactly to true. Enables the deterministic
# generated sample-plan importer/inventory; generated plans never enter public Load Sample Plan.
ENABLE_GENERATED_PLAN_RND=false
# DEVELOPMENT ONLY: serve clearly-labelled SAMPLE seat data so the open/full UI
# can be exercised. Ignored (with a warning) when NODE_ENV=production.
AVAILABILITY_FIXTURE_ENABLED=false

# --- Optional features ---
# Direct Workday Student integration. Stays false until SCU has authorized an
# integration AND real credentials are provisioned; nothing in the UI may
# claim a Workday connection while this is false. See docs/WORKDAY_INTEGRATION.md.
WORKDAY_INTEGRATION_ENABLED=false
# Restricts who may run the manual Workday section-sync (paste) admin action.
WORKDAY_SYNC_ADMIN_EMAIL=
# --- Who may use CampusVal (docs/PILOT_STATUS.md) ---
# pilot (default when unset): only the named people below plus department
# administrators with a program scope. An @scu.edu address alone is refused.
# institution: every @scu.edu account too. Set ONLY after SCU approves a broader
# rollout. Any other value refuses to start.
CAMPUSVAL_ACCESS_MODE=pilot
# Comma-separated, exact addresses of invited pilot testers. Never commit real ones.
PILOT_TESTER_EMAILS=
# Comma-separated allowlist of invited external reviewers without an @scu.edu
# address. See docs/EXTERNAL_REVIEWERS.md.
GUEST_REVIEWER_EMAILS=
# Comma-separated emails allowed to open the admin dashboards. These are also the
# super admins of Program Requirements Admin (every program, and granting scopes).
# A department administrator needs NO entry here: grant a program scope with
# `pnpm --filter @workspace/api-server run admin:scope -- grant --email <e> --program <key>`.
ADMIN_EMAILS=
# Optional. Which loaded Bulletin edition builds the requirements sidebar (for
# example 2026-27). Unset = the latest edition. See docs/BULLETIN_BASELINE.md.
REQUIREMENTS_BULLETIN_EDITION=
# --- AI (advisor chat, voice, evaluation bench) — SCU-approved providers only ---
# gemini | vertex | anthropic. Unset = AI features OFF. There is no OpenAI
# option and no fallback. See docs/migration/AI_PROVIDER_MIGRATION.md.
AI_PROVIDER=
# gemini (Gemini API, API key):
GEMINI_API_KEY=
GEMINI_MODEL=
# vertex (Gemini on Vertex AI inside SCU's GCP project; no API key — uses the
# Cloud Run service account, which needs roles/aiplatform.user):
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=
# Voice answers (gemini/vertex). Optional overrides.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# anthropic (Claude; text only — voice is unavailable with this provider):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional ElevenLabs voice for spoken answers. An extra external service —
# leave unset unless SCU approves it (the AI provider voices answers otherwise).
ELEVENLABS_API_KEY=
VOICE_TTS_VOICE_ID=

# --- Vercel-specific (ignored elsewhere) ---
# Overrides the canonical/OG origin baked into the landing page at build time
# on Vercel. Elsewhere PUBLIC_APP_URL is used at request time.
# (Auto-derived from Vercel's own env vars when unset — see
# artifacts/scu-advising/scripts/postbuild-seo.mjs.)

# --- Mobile app (Expo) only ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PROXY_URL=
