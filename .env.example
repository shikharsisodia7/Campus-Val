# CampusVal environment variables — names only, never real values.
# See docs/SCU_DEPLOYMENT.md (hosting) and docs/DEPLOYMENT.md (Vercel) for where
# each of these is configured. The server validates this at startup and names
# every missing/invalid variable in one message (lib/config.ts).

# --- Required everywhere (local, container, VM, Vercel) ---
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Baked into the web bundle at BUILD time (a public key, not a secret).
VITE_CLERK_PUBLISHABLE_KEY=

# --- Server process (long-running hosts: VM / container) ---
# Required by `node artifacts/api-server/dist/index.mjs`; ignored on Vercel.
PORT=8080
# Interface to bind. 0.0.0.0 (default) for containers/VMs; 127.0.0.1 when a
# same-host reverse proxy is the only client.
HOST=0.0.0.0
# production | development | test
NODE_ENV=production
# pino level: fatal|error|warn|info|debug|trace (default info). Logs are JSON
# on stdout in production, ready for any log shipper.
LOG_LEVEL=info

# --- Public URL, reverse proxy, TLS, CORS ---
# The externally visible origin, e.g. https://campusval.scu.edu. Used for
# canonical/OG URLs and for building absolute upload links. Set it in production.
PUBLIC_APP_URL=
# How many reverse-proxy hops to trust for X-Forwarded-* (client IP, https).
# Unset/false = trust none (correct when exposed directly). 1 = one proxy.
# Also accepts a hop count or a subnet list such as "loopback, 10.0.0.0/8".
TRUST_PROXY=
# Extra browser origins allowed to call the API with credentials (comma-
# separated). The bundled web app is same-origin and needs none. Production
# default = PUBLIC_APP_URL only.
CORS_ALLOWED_ORIGINS=

# --- Database ---
# Max connections in the pg pool. Default 5 (sized for serverless); raise for a
# long-running server, e.g. 10-20.
DATABASE_POOL_MAX=
# Where `node dist/migrate.mjs` finds migrations. Default: lib/db/drizzle next
# to the bundle (the container image already lays this out).
MIGRATIONS_DIR=

# --- Private object storage (Academic Progress Report uploads) ---
# Which backend: vercel-blob | local | replit. If unset it is inferred:
# VERCEL set -> vercel-blob; PRIVATE_STORAGE_DIR set -> local; PRIVATE_OBJECT_DIR set -> replit.
# With none configured, APR upload is disabled (the rest of CampusVal works).
PRIVATE_STORAGE_PROVIDER=
# local: an absolute, PERSISTENT, PRIVATE directory. Back it up. Never serve it
# statically. In the container image this is /var/lib/campusval/private.
PRIVATE_STORAGE_DIR=
# local: 32+ random characters; signs the 15-minute upload links. Rotating it
# only invalidates in-flight uploads, not stored files.
STORAGE_SIGNING_SECRET=
# vercel-blob: auto-populated when a PRIVATE Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# replit: object-storage sidecar (Replit runtime only).
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Live section availability (Workday) — OFF until SCU approves a source ---
# Keep false until SCU/Tony provide the supported mechanism and credentials.
# Nothing in the UI claims live data while this is false.
WORKDAY_AVAILABILITY_ENABLED=false
# HTTPS endpoint returning CampusVal's documented availability payload
# (docs/SECTION_AVAILABILITY.md#the-input-contract). No default; no invented URL.
WORKDAY_AVAILABILITY_URL=
# Credential issued by SCU for that endpoint. Server-side only.
WORKDAY_AVAILABILITY_AUTH_TOKEN=
# Header carrying the credential (default Authorization) and its prefix
# (default "Bearer"; set empty to send the token bare).
WORKDAY_AVAILABILITY_AUTH_HEADER=
WORKDAY_AVAILABILITY_AUTH_SCHEME=
# Upstream request timeout, ms (default 5000).
WORKDAY_AVAILABILITY_TIMEOUT_MS=
# One upstream call per term per this many seconds, however many students ask
# (default 60).
WORKDAY_AVAILABILITY_CACHE_TTL_SECONDS=
# Data younger than this is labelled "live" (default 120).
WORKDAY_AVAILABILITY_LIVE_WITHIN_SECONDS=
# Data older than this is "stale" and its status is shown as unknown (default 900).
WORKDAY_AVAILABILITY_STALE_AFTER_SECONDS=
# DEVELOPMENT ONLY: serve clearly-labelled SAMPLE seat data so the open/full UI
# can be exercised. Ignored (with a warning) when NODE_ENV=production.
AVAILABILITY_FIXTURE_ENABLED=false

# --- Optional features ---
# Direct Workday Student integration. Stays false until SCU has authorized an
# integration AND real credentials are provisioned; nothing in the UI may
# claim a Workday connection while this is false. See docs/WORKDAY_INTEGRATION.md.
WORKDAY_INTEGRATION_ENABLED=false
# Restricts who may run the manual Workday section-sync (paste) admin action.
WORKDAY_SYNC_ADMIN_EMAIL=
# Comma-separated allowlist of non-@scu.edu emails allowed to sign in (invited
# external reviewers). @scu.edu always works. See docs/DEPLOYMENT.md.
GUEST_REVIEWER_EMAILS=
# Comma-separated emails allowed to open the admin dashboards.
ADMIN_EMAILS=
# AI advisor chat / evaluation (Replit-only internal proxy). Leave unset elsewhere.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Voice (text-to-speech). Optional.
ELEVENLABS_API_KEY=
VOICE_TTS_VOICE_ID=

# --- Vercel-specific (ignored elsewhere) ---
# Overrides the canonical/OG origin baked into the landing page at build time
# on Vercel. Elsewhere PUBLIC_APP_URL is used at request time.
# (Auto-derived from Vercel's own env vars when unset — see
# artifacts/scu-advising/scripts/postbuild-seo.mjs.)

# --- Mobile app (Expo) only ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PROXY_URL=
