# CampusVal environment variables — names only, never real values.
# See docs/DEPLOYMENT.md for where each of these gets configured.

# --- Required everywhere (local, Replit, Vercel) ---
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Required on Vercel only (private Academic Progress Report storage) ---
# Auto-populated by Vercel when a Blob store is connected to the project;
# only set manually for local testing against a real Blob store.
BLOB_READ_WRITE_TOKEN=

# --- Required on Replit / local dev only (object storage sidecar) ---
# Not used and not needed on Vercel — see lib/storage/vercelBlobProvider.ts.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Optional: AI features ---
# Replit-only internal AI proxy. Leave unset outside Replit — AI advisor
# chat/evaluation features degrade gracefully without it.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Voice feature (text-to-speech). Optional — voice page shows a clear
# "not configured" state without it.
ELEVENLABS_API_KEY=
VOICE_TTS_VOICE_ID=

# --- Optional: misc ---
# Restricts who may run the Workday section-sync admin action.
WORKDAY_SYNC_ADMIN_EMAIL=
# Direct Workday Student integration. Stays false until SCU has authorized an
# integration AND real credentials are provisioned; nothing in the UI may
# claim a Workday connection while this is false. Tenant/client/secret values
# are deliberately NOT listed here — they must never be invented or committed.
# See docs/WORKDAY_INTEGRATION.md.
WORKDAY_INTEGRATION_ENABLED=false
# Comma-separated allowlist of non-@scu.edu emails allowed to sign in (for
# invited external prototype reviewers). @scu.edu always works regardless
# of this list. See docs/DEPLOYMENT.md for how to add real reviewer emails.
GUEST_REVIEWER_EMAILS=
# Overrides the canonical/OG/JSON-LD origin baked into the landing page at
# build time. Auto-derived from Vercel's own env vars when unset — see
# artifacts/scu-advising/scripts/postbuild-seo.mjs.
PUBLIC_APP_URL=
LOG_LEVEL=

# --- Local dev only ---
NODE_ENV=
PORT=

# --- Mobile app (Expo) only ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PROXY_URL=
